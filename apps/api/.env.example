# Local development only. Never commit real credentials or session values.
APP_ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./pricing-calculator.db
# Comma-separated browser origins allowed only for direct local development.
# Railway production uses the same-origin Caddy /api proxy and needs no public CORS origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Currency enablement is deployment configuration. Decimal precision is a code invariant:
# USD, INR, and AED each use 100 integer minor units per whole currency unit.
PRICING_SUPPORTED_CURRENCIES=USD,INR,AED
PRICING_DEFAULT_CURRENCY=USD

# Opaque session credential is stored in an HttpOnly cookie; only its hash is persisted.
SESSION_COOKIE_NAME=pricing_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
# Use a unique, high-entropy value outside local development. This derives
# per-session CSRF tokens and must never be exposed to the frontend.
CSRF_SECRET=local-development-only-change-me
